{
  "name": "harbor",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "scripts/setup.sh",
    "dev": "pnpm --filter @harbor/web dev",
    "research:collect": "node scripts/collect-research.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "check": "biome ci . && turbo run typecheck test build && knip",
    "prepare": "lefthook install",
    "docs:dev": "pnpm --filter @harbor/docs dev",
    "docs:build": "pnpm --filter @harbor/docs build",
    "docs:preview": "pnpm --filter @harbor/docs preview"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
